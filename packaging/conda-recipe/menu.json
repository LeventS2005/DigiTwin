{
  "$id": "https://schemas.conda.org/menuinst-1-1-3.schema.json",
  "menu_name": "meshforge",
  "menu_items": [
    {
      "name": "meshforge Workbench",
      "description": "meshforge — mesh & solve Workbench (native QtWebEngine window over the local 127.0.0.1 web UI)",
      "command": ["{{ PREFIX }}/bin/meshforge-desktop"],
      "activate": false,
      "terminal": false,
      "platforms": {
        "osx": {
          "CFBundleName": "meshforge",
          "CFBundleDisplayName": "meshforge Workbench",
          "CFBundleVersion": "0.1.0",
          "CFBundleIdentifier": "com.meshforge.workbench"
        },
        "linux": {},
        "win": {
          "command": ["{{ SCRIPTS_DIR }}\\meshforge-desktop.exe"]
        }
      }
    }
  ]
}
