{
  "$id": "https://schemas.conda.org/menuinst-1-1-3.schema.json",
  "menu_name": "DigiTwin",
  "menu_items": [
    {
      "name": "DigiTwin Workbench",
      "description": "DigiTwin — mesh & solve Workbench (native QtWebEngine window over the local 127.0.0.1 web UI)",
      "command": ["{{ PREFIX }}/bin/digitwin-desktop"],
      "activate": false,
      "terminal": false,
      "platforms": {
        "osx": {
          "CFBundleName": "DigiTwin",
          "CFBundleDisplayName": "DigiTwin Workbench",
          "CFBundleVersion": "1.0.0",
          "CFBundleIdentifier": "com.digitwin.workbench"
        },
        "linux": {},
        "win": {
          "command": ["{{ SCRIPTS_DIR }}\\digitwin-desktop.exe"]
        }
      }
    }
  ]
}
